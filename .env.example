# Database: a local SQLite file for development, Turso in production.
DATABASE_URL="file:local.db"
# DATABASE_URL="libsql://ripasso-<your-org>.turso.io"
# Not needed for file: URLs. Create with `turso db tokens create ripasso`.
DATABASE_AUTH_TOKEN=""

# Public URL of the app (used for auth callbacks and cookies).
ORIGIN="http://localhost:5173"

# Better Auth secret: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# Google sign-in (optional; the button is hidden when unset).
# Redirect URI: <ORIGIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
